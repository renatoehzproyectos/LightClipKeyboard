<!-- LightClip v9 (Master Plan §7): the enter/action key previously filled its
     entire touch target edge-to-edge with the accent color, making it read as
     disproportionately dominant next to normal keys. Insetting the pill gives
     it breathing room like a deliberate accent chip, while the touch target
     (governed by the Key's own bounds, not this drawable) is unchanged. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="3dp"
    android:insetTop="4dp"
    android:insetRight="3dp"
    android:insetBottom="4dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/keyAccentBackgroundColor" />
        <corners android:radius="@dimen/button_corner_radius_lxx" />
    </shape>
</inset>
