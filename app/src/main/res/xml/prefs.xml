<?xml version="1.0" encoding="utf-8"?>
<!-- LightClip settings root (Master Plan §23, §24). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="english_ime_settings">

    <PreferenceCategory android:title="@string/settings_category_keyboard">
        <PreferenceScreen
            android:fragment="rkr.simplekeyboard.inputmethod.latin.settings.PreferencesSettingsFragment"
            android:title="@string/settings_screen_preferences"
            android:summary="@string/settings_screen_preferences_summary"
            android:key="screen_preferences" />
        <PreferenceScreen
            android:fragment="rkr.simplekeyboard.inputmethod.latin.settings.KeyPressSettingsFragment"
            android:title="@string/settings_screen_key_press"
            android:summary="@string/settings_screen_key_press_summary"
            android:key="screen_key_press" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_personalization">
        <PreferenceScreen
            android:fragment="rkr.simplekeyboard.inputmethod.latin.settings.AppearanceSettingsFragment"
            android:title="@string/settings_screen_appearance"
            android:summary="@string/settings_screen_appearance_summary"
            android:key="screen_appearance" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_about">
        <Preference
            android:title="@string/privacy_policy"
            android:summary="@string/privacy_policy_summary"
            android:key="privacy_policy" />
        <Preference
            android:title="@string/license"
            android:summary="@string/license_summary"
            android:key="license" />
    </PreferenceCategory>
</PreferenceScreen>
