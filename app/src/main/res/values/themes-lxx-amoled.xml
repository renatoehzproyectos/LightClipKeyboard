<?xml version="1.0" encoding="utf-8"?>
<!--
  LightClip AMOLED theme (Master Plan §6).
  Structurally identical to KeyboardTheme.LXX_Dark — only the color set differs
  (true black surfaces, minimal contrast between elevations) — so this file
  mirrors themes-lxx-dark.xml item-for-item on purpose; keep the two in sync
  when tuning shared structural attrs (paddings, ratios, drawables).
-->

<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="KeyboardTheme.LXX_Amoled">
        <item name="inputViewStyle">@style/InputView</item>
        <item name="keyboardStyle">@style/Keyboard.LXX_Amoled</item>
        <item name="keyboardViewStyle">@style/KeyboardView.LXX_Amoled</item>
        <item name="mainKeyboardViewStyle">@style/MainKeyboardView.LXX_Amoled</item>
        <item name="moreKeysKeyboardStyle">@style/MoreKeysKeyboard.LXX_Amoled</item>
        <item name="moreKeysKeyboardViewStyle">@style/MoreKeysKeyboardView.LXX_Amoled</item>
        <item name="functionalTextColor">@color/key_text_color_lxx_amoled</item>
        <item name="popupPanelBackgroundColor">@color/background_secondary_lxx_amoled</item>
        <item name="keyPressedBackgroundColor">@color/key_background_pressed_lxx_amoled</item>
        <item name="keyNormalBackgroundColor">@color/key_background_normal_lxx_amoled</item>
        <item name="keyFunctionalBackgroundColor">@color/key_functional_background_lxx_amoled</item>
        <item name="keyAccentBackgroundColor">@color/key_accent_background_lxx_amoled</item>
        <item name="keyAccentPressedBackgroundColor">@color/key_accent_pressed_background_lxx_amoled</item>
        <item name="keyOnAccentColor">@color/key_on_accent_lxx_amoled</item>
        <item name="panelSurfaceColor">@color/panel_surface_lxx_amoled</item>
        <item name="panelOutlineColor">@color/panel_outline_lxx_amoled</item>
    </style>
    <style
        name="Keyboard.LXX_Amoled"
        parent="Keyboard"
    >
    </style>
    <style
        name="KeyboardView.LXX_Amoled"
        parent="KeyboardView"
    >
        <item name="android:background">@color/background_lxx_amoled</item>
        <item name="keyBackground">@drawable/btn_keyboard_key</item>
        <item name="functionalKeyBackground">@drawable/btn_keyboard_key_functional</item>
        <item name="spacebarBackground">@drawable/btn_keyboard_spacebar</item>
        <item name="keyTextColor">@color/key_text_color_lxx_amoled</item>
        <item name="keyTextInactivatedColor">@color/key_functional_text_color_lxx_amoled</item>
        <item name="keyHintLetterColor">@color/key_hint_letter_color_lxx_amoled</item>
        <item name="keyHintLabelColor">@color/key_text_inactive_color_lxx_amoled</item>
        <item name="keyShiftedLetterHintInactivatedColor">@color/key_text_inactive_color_lxx_amoled</item>
        <item name="keyShiftedLetterHintActivatedColor">@color/key_text_color_lxx_amoled</item>
        <item name="keyPreviewTextColor">@color/key_text_color_lxx_amoled</item>
    </style>
    <style
        name="MainKeyboardView.LXX_Amoled"
        parent="KeyboardView.LXX_Amoled"
    >
        <item name="keyPreviewBackground">@drawable/keyboard_key_feedback_background</item>
        <item name="keyPreviewHeight">@dimen/config_key_preview_height_lxx</item>
        <item name="keyPreviewWidth">@dimen/config_key_preview_width_lxx</item>
        <item name="keyPreviewOffset">@dimen/config_key_preview_offset_lxx</item>
        <item name="keyPreviewDismissAnimator">@anim/key_preview_dismiss_lxx</item>
        <item name="languageOnSpacebarTextColor">@color/key_text_inactive_color_lxx_amoled</item>
    </style>
    <style
        name="MoreKeysKeyboard.LXX_Amoled"
        parent="Keyboard.LXX_Amoled"
    >
        <item name="keyboardTopPadding">0%p</item>
        <item name="keyboardBottomPadding">0%p</item>
        <item name="horizontalGap">0%p</item>
    </style>
    <style
        name="MoreKeysKeyboardView.LXX_Amoled"
        parent="KeyboardView.LXX_Amoled"
    >
        <item name="android:background">@drawable/keyboard_popup_panel_background</item>
        <item name="keyBackground">@drawable/btn_keyboard_key_popup</item>
        <item name="keyTypeface">normal</item>
        <item name="verticalCorrection">@dimen/config_more_keys_keyboard_vertical_correction</item>
    </style>
</resources>
