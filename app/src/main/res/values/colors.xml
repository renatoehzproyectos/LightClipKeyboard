    <color name="key_background_pressed_lxx_light">#FFE8E4D9</color>
    <!-- Color resources for LXX_Dark theme. -->
    <!-- LightClip v9: warm charcoal palette (Master Plan §5), replacing the
         generic blue-gray Material dark values above. Token mapping:
           background_lxx_dark           <- backgroundPrimary
           background_secondary_lxx_dark <- surfaceElevated
           key_background_normal_lxx_dark  <- keyNormal (now opaque, not a white-alpha wash)
           key_background_pressed_lxx_dark <- keyPressed
           key_text_*                      <- textPrimary / textSecondary / textTertiary -->
    <color name="background_lxx_dark">#FF11110F</color>
    <color name="background_secondary_lxx_dark">#FF24231F</color>
    <color name="key_text_color_lxx_dark">#FFF5F1E8</color>
    <color name="key_functional_text_color_lxx_dark">#FFB0ACA1</color>
    <color name="key_text_inactive_color_lxx_dark">#FF77736A</color>
    <color name="key_hint_letter_color_lxx_dark">#70B0ACA1</color>
    <color name="key_background_normal_lxx_dark">#FF292821</color>
    <color name="key_background_pressed_lxx_dark">#FF36342D</color>
    <!-- Dimensions for all themes. -->
    <dimen name="button_corner_radius_lxx">12dp</dimen>
    <dimen name="key_preview_corner_radius_lxx">14dp</dimen>
    <dimen name="panel_corner_radius">16dp</dimen>

    <!-- LightClip v8: Material 3 role colors per theme. -->
