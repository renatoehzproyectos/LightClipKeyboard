    <color name="key_background_normal_lxx_system">#FFFFFFFF</color>
    <color name="key_background_pressed_lxx_system">#FFD9DCE1</color>
    <!-- Color resources for LXX_Light theme. -->
    <!-- LightClip v9: warm white background (Master Plan §6) replacing the
         cool blue-gray Material default. -->
    <color name="background_lxx_light">#FFFBF9F4</color>
    <color name="background_secondary_lxx_light">#FFFFFFFF</color>
    <color name="key_text_color_lxx_light">#FF211F1A</color>
